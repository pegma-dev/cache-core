{
  "name": "@pegma/cache-core",
  "version": "0.1.0",
  "description": "Provider-neutral ephemeral caching: namespaced keys, cache-aside getOrCompute, and an in-memory store.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/cache-core.git",
    "directory": "packages/cache-core"
  },
  "dependencies": {
    "@pegma/spine": "0.1.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  }
}
